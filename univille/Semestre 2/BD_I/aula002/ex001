CREATE DATABASE AULA2010

USE AULA2010

CREATE TABLE FUNCIONARIOS
(
    IDFUNCIONARIO INT IDENTITY
            CONSTRAINT PK_FUNCIONARIOS PRIMARY KEY,
    NOMEFUNCIONARIO CHAR(50)
)

SELECT * FROM FUNCIONARIOS

INSERT FUNCIONARIOS (NOMEFUNCIONARIO)
VALUES ('DORNEL')

CREATE TABLE DEPENDENTES
(
    IDDEPENDENTES INT IDENTITY
        CONSTRAINT PK_DEPENDENTES PRIMARY KEY,
    NOMEDEPENDENTE CHAR(50),
    IDFUNCIONARIO INT
)

ALTER TABLE DEPENDENTES 
    ADD CONSTRAINT FK_FUNCIONARIO_DEPENDENTES FOREIGN KEY (IDFUNCIONARIO)
        REFERENCES FUNCIONARIOS(IDFUNCIONARIO)

SELECT * FROM FUNCIONARIOS
SELECT * FROM DEPENDENTES

